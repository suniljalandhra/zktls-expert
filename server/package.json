{
  "name": "zktls-expert-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:local": "LOCAL_CHAIN=1 node --env-file=../.env --import tsx --test test/local-chain.test.ts"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "2.10.0",
    "@hono/node-server": "2.1.5",
    "@reclaimprotocol/js-sdk": "5.8.3",
    "ethers": "6.17.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
