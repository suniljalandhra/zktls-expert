# Server-only. Copy to .env and fill in. Never commit .env.

# Reclaim (from https://dev.reclaimprotocol.org/)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
# Optional: pin an exact provider version (e.g. 1.0.0). Empty = latest at session creation.
RECLAIM_PROVIDER_VERSION=

# Claim rule. GITHUB_USERNAME_PARAM is the extracted parameter holding the GitHub login (required,
# used for one-attestation-per-account). Set CLAIM_COUNT_PARAM + CLAIM_MIN_COUNT for a threshold claim,
# e.g. CLAIM_COUNT_PARAM=contributions CLAIM_MIN_COUNT=50. The server logs the real param names on first proof.
GITHUB_USERNAME_PARAM=username
CLAIM_COUNT_PARAM=
CLAIM_MIN_COUNT=0

# Optional: on-chain EAS attestation. Leave these empty for verify-only mode (proof checked by the server,
# result shown in the browser, nothing written on-chain). To enable, fill all four and run register-schema.
ATTESTER_PRIVATE_KEY=
RPC_URL=
EAS_ADDRESS=
SCHEMA_UID=
# Used only when attesting (Sepolia values from https://docs.attest.org/docs/quick--start/contracts):
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# EAS_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
SCHEMA_REGISTRY_ADDRESS=0x0a7E2Ff54e76B8E6659aedc9103FB21c038050D0
EXPLORER_URL=https://sepolia.easscan.org

# Server
PORT=8787
WEB_ORIGIN=http://localhost:3000
STORE_PATH=./data/store.json
