# Server-only. Copy to .env and fill in. Never commit .env.

# Reclaim (from https://dev.reclaimprotocol.org/)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
# Optional: pin an exact provider version (e.g. 1.0.0). Empty = latest at session creation.
RECLAIM_PROVIDER_VERSION=

# Claim rule. GITHUB_USERNAME_PARAM is the extracted parameter holding the GitHub login (required,
# used for one-attestation-per-account). Set CLAIM_COUNT_PARAM + CLAIM_MIN_COUNT for a threshold claim,
# e.g. CLAIM_COUNT_PARAM=contributions CLAIM_MIN_COUNT=50. The server logs the real param names on first proof.
GITHUB_USERNAME_PARAM=username
CLAIM_COUNT_PARAM=
CLAIM_MIN_COUNT=0

# On-chain EAS attestation. Default: a local Anvil chain (npm --prefix scripts run chain, then deploy-local).
# Leave ATTESTER_PRIVATE_KEY/RPC_URL/EAS_ADDRESS/SCHEMA_UID empty for verify-only mode (nothing on-chain).
ATTESTER_PRIVATE_KEY=
RPC_URL=http://127.0.0.1:8545
# Printed by `npm --prefix scripts run deploy-local`
EAS_ADDRESS=
SCHEMA_REGISTRY_ADDRESS=
SCHEMA_UID=
# EAS Scan base URL for result links. Empty on a local chain. For Sepolia: https://sepolia.easscan.org
EXPLORER_URL=

# Server
PORT=8787
WEB_ORIGIN=http://localhost:3000
STORE_PATH=./data/store.json
